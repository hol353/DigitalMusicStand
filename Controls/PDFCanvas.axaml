<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlackFolder.PDFCanvas"
             xmlns:vm="using:BlackFolder"
             x:DataType="vm:MainViewModel">
    <ZoomBorder x:Name="ZoomBorder"
                Stretch="None"
                PanButton="Left"
                ZoomSpeed="1.1"
                MinZoomX="1.0"
                MaxZoomX="2.0"
                MinZoomY="1.0"
                MaxZoomY="2.0"
                EnableConstrains="True"
                EnableGestureRotation="False"
                Background="White" ClipToBounds="True" Focusable="True"
                VerticalAlignment="Stretch">
        <StackPanel x:Name="MusicCanvas" Background="White">
             
        </StackPanel>
    </ZoomBorder>
</UserControl>
